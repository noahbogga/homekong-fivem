<?xml version="1.0" encoding="UTF-8"?>

<!--
  hk-scenario AI HANDLING PROFILE (CAIHandlingInfoMgr).
  Mounted via data_file 'FIVEM_LOVES_YOU_447B37BE29496FA0' (the undocumented AI-
  handling mounter; 'HANDLING_FILE' is WRONG - that's for CHandlingData and this
  file silently never loaded before v2.4.28).

  WHY THIS FILE MATTERS: the stock curve collapses allowed speed the instant a
  driver steers. Stock SPORTS_CAR is 65 m/s at 0deg but only 35 m/s (126 km/h) at
  6deg. Ambient/wander driving is a constant stream of 2-6deg lane-hold
  corrections, so EVERY car got pinned at ~126 km/h regardless of the cruise we
  command (the recurring "capped at 125/126" bug). This profile FLATTENS the
  small-angle band so a car holding its lane can run at its commanded cruise; only
  genuinely sharp turns (>20deg) still force a real slow-down for corners.

  The Lua per-car cruise/tier caps + accel governor remain the REAL speed limits;
  this just removes the engine ceiling so those caps can actually take effect.
  Angle = steering angle (deg); Speed = max allowed m/s at that angle (x3.6 = km/h).
-->
<CAIHandlingInfoMgr>
  <AIHandlingInfos>
    <Item type="CAIHandlingInfo">
      <Name>SPORTS_CAR</Name>
      <MinBrakeDistance value="12.000000" />
      <MaxBrakeDistance value="120.000000" />
      <MaxSpeedAtBrakeDistance value="200.000000" />
      <AbsoluteMinSpeed value="1.000000" />
      <AICurvePoints>
        <Item type="CAICurvePoint">
          <Angle value="0.000000" />
          <Speed value="110.000000" />
        </Item>
        <Item type="CAICurvePoint">
          <Angle value="2.000000" />
